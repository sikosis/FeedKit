name          @PACKAGE_NAME@
version       @VERSION@-@REVISION@
architecture  @ARCHITECTURE@
summary       "RSS and Atom feed services and library for Haiku"
description   "FeedKit provides a native Haiku feed library, a background feed server, and RSS and Atom parser add-ons."
vendor        "FeedKit contributors"
packager      "FeedKit contributors"
copyrights    { "Copyright (c) 2008-2009 Michael Davidson" }
licenses      { "MIT" }
urls          { "https://github.com/sikosis/FeedKit" }
source-urls   { "https://github.com/sikosis/FeedKit" }
provides {
	feedkit@SECONDARY_SUFFIX@ = @VERSION@
	lib:libfeedkit@SECONDARY_SUFFIX@ = @VERSION@
}
requires {
	haiku@SECONDARY_SUFFIX@
	lib:libcrypto@SECONDARY_SUFFIX@
	lib:libcurl@SECONDARY_SUFFIX@
	lib:libiconv@SECONDARY_SUFFIX@
	lib:libpcre@SECONDARY_SUFFIX@
	lib:libstdc++@SECONDARY_SUFFIX@
	lib:libxml2@SECONDARY_SUFFIX@
	lib:libz@SECONDARY_SUFFIX@
}
